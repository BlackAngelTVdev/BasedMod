<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ItemAdder</AssemblyName>
    <RootNamespace>ItemAdder</RootNamespace>
    <Version>1.5.2</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Chemins vers le jeu et BepInEx -->
  <PropertyGroup>
    <GameDir>E:\SteamLibrary\steamapps\common\Supermarket Together\</GameDir>
    <ManagedDir>$(GameDir)Supermarket Together_Data\Managed\</ManagedDir>
    <BepInExCoreDir>$(GameDir)BepInEx\core\</BepInExCoreDir>
    <PluginDir>$(GameDir)BepInEx\plugins\</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ManagedDir)UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.AI.Navigation">
      <HintPath>$(ManagedDir)Unity.AI.Navigation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.StarterAssets">
      <HintPath>$(ManagedDir)Unity.StarterAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(ManagedDir)PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Utilisé par le raccourci F5 (Input.GetKeyDown) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Utilisé par l'encadré du mode placement (GUI.Box / GUIStyle) -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Requis car GameData hérite de Mirror.NetworkBehaviour -->
    <Reference Include="Mirror">
      <HintPath>$(ManagedDir)Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Utilisés par le rayon Tabac : textes du nœud d'arbre de compétences et touche d'interaction -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(ManagedDir)Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Post-build : copie le DLL du mod dans BepInEx\plugins -->
  <Target Name="CopyPluginToGame" AfterTargets="Build">
    <MakeDir Directories="$(PluginDir)" />
    <!-- Évite de charger l'ancien DLL en plus du nouveau après le renommage. -->
    <Delete Files="$(PluginDir)MonSupermarketMod.dll" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="ItemAdder copié dans $(PluginDir)$(TargetFileName)" />
  </Target>

</Project>
